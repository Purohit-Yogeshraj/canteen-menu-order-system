# Canteen Order Queue System - Environment Variables
# Copy to .env for local development

# Supabase Credentials (leave blank to run in high-fidelity Mock Mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mode Override: set to 'true' to explicitly force local mock mode with BroadcastChannel
VITE_USE_MOCK_DATA=true

# Demo Controls: enable simulation tools for 4:45 PM cutoff and overdue orders
VITE_ENABLE_DEMO_CONTROLS=true
